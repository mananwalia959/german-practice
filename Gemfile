source "https://rubygems.org"

# Matches GitHub Pages' build environment. Bundles Jekyll plus the plugins
# that make plain .md files (no front matter) render with working links:
#   - jekyll-optional-front-matter : render .md files that have no YAML header
#   - jekyll-relative-links        : rewrite [x](file.md) -> file.html
#   - jekyll-readme-index          : serve README.md as the site homepage
gem "github-pages", group: :jekyll_plugins
